# Copy to .env and fill in. Never commit .env.

# Tavily: web search and page extraction (event credits, or app.tavily.com)
TAVILY_API_KEY=

# Nebius Token Factory: AI decision + image checks (access steps at the Build Desk)
NEBIUS_API_KEY=
# Base URL from the Token Factory console (OpenAI-compatible endpoint)
NEBIUS_BASE_URL=

# idealo MCP (optional: price checks for shop and marketplace modes)
IDEALO_MCP_URL=
IDEALO_API_KEY=

# n8n: webhook URL of the weekly vendor-watch workflow (filled in later)
N8N_WEBHOOK_URL=

# Optional company registers
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_API_TOKEN=
